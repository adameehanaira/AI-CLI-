{
  "name": "aira-cli-kit",
  "version": "0.1.0",
  "description": "Turn any AI API or AI model into a professional, cross-platform CLI application by configuring a single file.",
  "license": "MIT",
  "author": "Aira Group Of Technology <support@airaai.work.gd>",
  "homepage": "https://github.com/aira-group/aira-cli-kit",
  "repository": {
    "type": "git",
    "url": "https://github.com/aira-group/aira-cli-kit.git"
  },
  "bugs": {
    "url": "https://github.com/aira-group/aira-cli-kit/issues",
    "email": "support@airaai.work.gd"
  },
  "keywords": [
    "cli",
    "ai",
    "framework",
    "generator",
    "openai",
    "llm",
    "developer-tools",
    "cli-generator",
    "commander"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aira": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "chalk": "^5.3.0",
    "chalk-animation": "^2.0.3",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "dotenv": "^16.4.5",
    "figlet": "^1.7.0",
    "gradient-string": "^2.0.2",
    "inquirer": "^10.2.2",
    "js-yaml": "^4.1.0",
    "marked": "^14.1.2",
    "marked-terminal": "^7.1.0",
    "ora": "^8.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.8",
    "@types/gradient-string": "^1.1.6",
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.4",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.1"
  }
}
